/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "contact",
	// Pinned so wrangler cannot follow a cached account selection or a
	// differently-scoped token to an account that does not host this
	// worker — the failure there is "This Worker does not exist on your
	// account", which reads like the worker is gone. Not a secret: it is
	// in every dashboard URL.
	"account_id": "eb2fcf5554cafc637c5f9bbdcc3b8d1e",
	"main": "src/index.js",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	/**
	 * The per-IP limit `src/index.js` reads as `env.RATE_LIMITER`. Cloudflare's
	 * built-in Rate Limiting binding, so it needs no dashboard resource and no
	 * account id: declaring it here is the whole provisioning step. Counted per
	 * colo across isolates, which is what the in-isolate `Map` in the worker
	 * cannot be — that `Map` is per-isolate and empty after every cold start, so
	 * until this existed the deployed limit was far looser than the code reads.
	 *
	 * `limit` / `period` must stay in step with `rateLimit` in `src/index.js`
	 * (5 requests / 60 seconds). `period` accepts only 10 or 60. `namespace_id`
	 * is an arbitrary identifier scoped to this Worker — it names nothing
	 * outside this file, and changing it resets the counters.
	 */
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60,
			},
		},
	],
	"routes": [
		{
			"pattern": "contact.annieelliot.co.uk",
			"custom_domain": true,
		},
	],
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" }
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
