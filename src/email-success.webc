<!-- No <style> block left: the panel, the title, the message and the action
	all come from postcard-panel.webc and page-furniture.css. -->
<postcard-panel
	webc:nokeep
	panel-id="email-success"
	heading="Message Sent Successfully"
>
	<p class="postcard-message">
		Thank you for your message! Your letter has been posted and I will respond
		as soon as possible.
	</p>
	<a href="/" class="button">Return Home</a>
</postcard-panel>
