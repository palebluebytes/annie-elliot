---
metadata:
  title: "Message Not Sent | Contact Annie Elliot"
  description: "Your message to Annie Elliot could not be sent. Please try again, or reach the author another way."
---

<postcard-panel
	webc:nokeep
	panel-id="email-failure"
	heading="Message Could Not Be Sent"
>
	<p class="postcard-message">
		I'm sorry, but there was an issue sending your message. Please try again
		later or contact me directly through alternative means.
	</p>
	<a href="/contact" class="button">Try Again</a>
	<a href="/" class="button button-secondary">Return Home</a>
</postcard-panel>

<style>
	/* The only page with two actions, so the only page that has to rank them:
	   "Try Again" keeps the filled treatment from
	   src/_components/postcard-panel.webc and "Return Home" is outlined. */
	#email-failure .button-secondary {
		background-color: transparent;
		color: var(--taupe);
		border: 2px solid var(--taupe);

		&:hover {
			background-color: var(--taupe);
			color: var(--antiflash-white);
		}
	}
</style>
