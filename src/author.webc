</section>

<style>
	#author {
		padding-block: var(--space-l);

		h1 {
			/* One step wider than the shared .u-page-title's --space-l. Kept as
			   found: the extra air separates the title from the two-column
			   grid below, and the visual baseline is the only record of it. */
			margin-bottom: var(--space-xl);
		}

		.main-grid {
			gap: var(--space-2xl);
			text-align: justify;

			@media all and (min-width: 60rem) {
				grid-template-columns: 1fr 1fr;
			}

			div > p:first-of-type {
				margin-top: 0;
			}
		}

		/* Annie's social handles. Left-aligned against the justified prose
		   above: two short lines set justified would stretch to the column
		   width and open rivers between the three words. */
		.author-social {
			list-style: none;
			padding: 0;
			margin-top: var(--space-m);
			text-align: left;

			li {
				display: flex;
				align-items: center;
				gap: var(--space-2xs);
				margin-top: var(--space-2xs);
			}

			svg {
				/* Sized in `em` so the mark tracks the text beside it, and
				   `flex: none` so the flex row cannot squeeze it narrower than
				   it is tall. */
				flex: none;
				width: 1.1em;
				height: 1.1em;
				fill: currentColor;
			}
		}

		picture {
			display: block;

			img {
				width: 100%;
				display: block;
				/*
					The portrait is a 2:3 photograph, far taller than the prose beside
					it. Cropped from the bottom, which is where the empty shoulder room
					is, so the face survives whatever the frame becomes.
				*/
				aspect-ratio: 4 / 5;
				height: auto;
				object-fit: cover;
				object-position: 50% 10%;
			}

			/*
				Two columns: the photo takes its height from the prose, not the other
				way round. A normally-flowed image is what sizes the grid row, so it
				is taken out of flow — that leaves <picture> with no intrinsic height,
				the row is measured from the text column alone, and the stretched
				<picture> hands that height straight back to the image.
			*/
			@media all and (min-width: 60rem) {
				position: relative;

				img {
					position: absolute;
					inset: 0;
					width: 100%;
					height: 100%;
					aspect-ratio: auto;
				}
			}
		}
	}
</style>
