---
metadata:
  title: "Upcoming Book Events | Annie Elliot - Mr & Mrs Charles Dickens"
  description: "Find upcoming book events, readings, and appearances by Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story."
  pageType: "events"
---

<section id="events" class="events-section u-container">
	<section id="audience-say" class="audience-section">
		<div class="audience-header">
			<h1 class="u-page-title">What Audiences Say</h1>
			<h2>About Mrs Dickens Telling Her Story</h2>
		</div>

		<div class="featured-testimonial-wrapper">
			<div class="featured-content ornate-frame">
				<p>
					“RIVETING, EXCELLENT, FASCINATING, SPELLBINDING, TRANSFORMATIVE,
					ILLUMINATING, HUMOUROUS BUT HEARTBREAKING”
				</p>
			</div>
		</div>

		<div class="testimonials-grid">
			<div class="testimonial-item">
				<blockquote class="quote">A professional performance.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">Annie Elliot became Mrs Dickens.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					We didn't want to miss a single word.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					A very talented lady who kept us enthralled.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					Annie Elliot got right into the character of Mrs Dickens.
				</blockquote>
			</div>
		</div>
	</section>

	<h2 class="u-section-title section-heading">Upcoming Events</h2>

	<div webc:if="$data.calendar.futureEvents.length > 0">
		<event-card
			webc:nokeep
			webc:for="event of $data.calendar.futureEvents"
			:event="event"
			:is-past="false"
		></event-card>
	</div>

	<div webc:if="$data.calendar.futureEvents.length === 0">
		<p class="no-events">No upcoming events scheduled at this time.</p>
	</div>

	<div webc:if="$data.calendar.pastEvents.length > 0">
		<h2 class="u-section-title section-heading">Past Events</h2>

		<event-card
			webc:nokeep
			webc:for="event of $data.calendar.pastEvents"
			:event="event"
			:is-past="true"
		></event-card>
	</div>
</section>

<style>
	/* Shared ornamental frame. Drawn with border-image (a 9-slice) so the four
	   corners keep a fixed size and only the straight edges stretch, each along
	   its own axis. Used the same way everywhere eventFrame.svg wraps content
	   (the featured testimonial and every event card) so the frame never
	   distorts, whatever the height of what it surrounds.

	   Here, not in src/_components/event-card.webc, even though the card wears
	   it: the featured testimonial above wears it too, and a component's
	   <style> is bundled only when the component renders — so on a build with
	   no events at all (both lists empty) the testimonial would silently lose
	   its frame. Not in page-furniture.css either: that module is the
	   furniture EVERY page needs, and this is one page's ornament, inlined
	   into the critical CSS of all seven if it went there. */
	.ornate-frame {
		border-style: solid;
		border-width: 46px 40px;
		border-image-source: url("/images/eventFrame.svg");
		border-image-slice: 30% 22%;
		border-image-repeat: stretch;
	}

	.events-section {
		padding-block: var(--space-l);
		font-family: var(--font-base);
		text-align: center;

		.audience-section {
			padding-bottom: var(--space-2xl);
			margin-bottom: var(--space-2xl);
			border-bottom: 1px solid var(--light-beige);
			position: relative;

			.audience-header {
				margin-bottom: var(--space-xl);

				/* Deliberately no font-size: the h1 takes --step-4 from
				   design-system.css, so it matches the h1 on every other page. It
				   is still the largest type here — the next heading down,
				   .section-heading, is --step-3. */
				h1 {
					/* No bottom margin, unlike the shared .u-page-title: its own
					   subtitle follows, and .audience-header carries the gap down
					   to the testimonials. */
					margin-bottom: 0;
					font-weight: 700;
					line-height: 1.1;
					text-transform: none;
					letter-spacing: normal;
				}

				h2 {
					font-family: var(--font-condensed);
					font-size: var(--step-2);
					color: var(--taupe);
					margin-top: var(--space-s);
					margin-bottom: var(--space-xs);
					font-weight: normal;
					font-style: normal;
				}
			}

			.featured-testimonial-wrapper {
				margin: 0 auto var(--space-xl);
				max-width: 900px;
				padding: var(--space-s);
				position: relative;

				.featured-content {
					display: flex;
					align-items: center;
					justify-content: center;

					p {
						font-family: var(--font-base);
						font-size: var(--step-1);
						color: var(--taupe);
						font-weight: 700;
						line-height: 1.4;
						margin: 0;
						text-align: center;
						letter-spacing: 0.05em;
					}

					/* On phones the long all-caps words ("TRANSFORMATIVE,") plus the
					   frame's border-width can push the content wider than the
					   wrapper and overflow the viewport. Shrink the font and drop the
					   letter-spacing so the text — and therefore the frame — fit. */
					@media (max-width: 40rem) {
						p {
							font-size: var(--step-0);
							letter-spacing: normal;
						}
					}
				}
			}

			.testimonials-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-around;
				gap: var(--space-l);
				max-width: 1100px;
				margin-inline: auto;
			}

			.testimonial-item {
				flex: 1 1 320px;
				max-width: 350px;
				margin: 0;
				padding: 2.5rem 3rem;
				border: 1px solid var(--light-beige);
				box-shadow: 3px 3px 10px var(--shadow-light);
				position: relative;
				background-color: transparent;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				transition: all 0.3s ease;

				&:hover {
					box-shadow: 5px 5px 15px var(--shadow-medium);
					transform: translateY(-2px);
				}
			}

			/*
				The quote marks are inline, not absolutely positioned: these
				testimonials wrap to two lines at most widths, and an absolute
				mark anchors to the block's corners rather than to the text, so
				it drifts away from the first/last words as the wrap changes.
				`line-height: 0` keeps the oversized glyphs from stretching the
				line box.
			*/
			.quote {
				font-family: var(--font-italic);
				font-style: italic;
				line-height: 1.6;
				margin: 0;
				text-align: center;
				font-size: 1.1rem;
				color: var(--taupe);
				text-wrap: balance;

				&::before,
				&::after {
					font-family: serif;
					font-size: 1.9rem;
					line-height: 0;
					vertical-align: -0.15em;
					opacity: 0.3;
					color: var(--taupe);
				}

				&::before {
					content: "“";
					margin-inline-end: 0.1em;
				}

				&::after {
					content: "”";
					margin-inline-start: 0.1em;
				}
			}
		}

		.section-heading {
			font-family: var(--font-base);
			font-size: var(--step-3);
			text-transform: none;
			letter-spacing: normal;
			color: var(--taupe);
			margin-block: var(--space-2xl) var(--space-l);
			position: relative;
			display: block;
			width: fit-content;
			margin-inline: auto;
			text-align: center;
			border-bottom: 1px solid var(--light-beige);
			padding-bottom: var(--space-xs);
		}

		.no-events {
			font-family: var(--font-italic);
			font-style: italic;
			padding: var(--space-s);
		}
	}
</style>
