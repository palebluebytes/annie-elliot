<footer>
	<img
		webc:is="eleventy-image"
		src="assets/images/separator.webp"
		alt=""
		width="200, 360, 520"
		sizes="clamp(6.75rem, 6.4rem + 1.4vw, 7.5rem)"
	/>

	<p id="quote">So the world may know he loved me once.</p>

	<img
		webc:is="eleventy-image"
		src="assets/images/separator.webp"
		alt=""
		width="200, 360, 520"
		sizes="clamp(6.75rem, 6.4rem + 1.4vw, 7.5rem)"
	/>

	<p class="footer-credits">
		©<span webc:nokeep @text="(new Date()).getFullYear()"></span> Built by
		<a href="https://palebluebytes.space">Pale Blue Bytes</a>
	</p>
</footer>

<style>
	footer {
		background-color: var(--eerie-black);
		font-family: var(--font-base);
		text-align: center;
		/* --step--2, not --font-view--2: the latter has never existed. The
		   footer was authored against the type scale as it stood in Aug 2025,
		   when --step--2 was the smallest rung, and the reference was a typo
		   from the first commit — an invalid declaration the parser drops, so
		   the footer silently inherited 16px from the UA default instead.
		   Nothing visible moves: every text node in here (#quote,
		   .footer-credits and its link) sets its own size, and the separators
		   are `display: block` with rem-based bounds, so the footer's own
		   font-size is what a future direct child would inherit. */
		font-size: var(--step--2);
		padding-block: var(--space-s);
		color: var(--antiflash-white);

		#quote {
			font-size: var(--step-1);
			font-weight: normal;
			font-family: var(--font-condensed);
			margin: 0;
		}

		picture:last-of-type > img {
			transform: rotate(180deg);
			margin-bottom: var(--space-s);
		}

		picture > img {
			max-width: var(--space-3xl);
			margin: auto;
			width: 100%;
			height: auto;
			transform: rotate(0deg);
		}

		.footer-credits {
			font-size: var(--step--2);
			margin-top: var(--space-xs);
			margin-bottom: 0;

			a {
				color: var(--antiflash-white);
				text-decoration: underline;
				text-decoration-color: var(--battleship-gray);
				text-underline-offset: 2px;
				font-size: var(--step-2);
				font-family: var(--font-cursive);

				&:hover {
					text-decoration-color: var(--antiflash-white);
				}
			}
		}
	}
</style>
