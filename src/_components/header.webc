<header class="u-container">
	<img
		webc:is="eleventy-image"
		src="assets/images/separator.webp"
		alt=""
		id="flourish-top"
		loading="eager"
		width="200, 360, 520"
		sizes="clamp(6.75rem, 6.4rem + 1.4vw, 7.5rem)"
	/>

	<nav-links
		nav-label="Main navigation"
		font-size="var(--step-0)"
		dot-color="var(--battleship-gray)"
	></nav-links>
	<img
		webc:is="eleventy-image"
		src="assets/images/separator.webp"
		alt=""
		id="flourish-bottom"
		loading="eager"
		width="200, 360, 520"
		sizes="clamp(6.75rem, 6.4rem + 1.4vw, 7.5rem)"
	/>
</header>

<style>
	header {
		text-align: center;
		padding-block: var(--space-s);

		#flourish-top,
		#flourish-bottom {
			max-width: var(--space-3xl);
			margin: auto;
			width: 100%;
			height: auto;
			padding-bottom: var(--space-s);
		}

		/* The pair mirrors: the lower one is the same motif turned to face back up. */
		#flourish-bottom {
			transform: rotate(180deg);
		}
	}
</style>
