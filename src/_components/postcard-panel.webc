<!-- The postcard: a titled panel with a double-ruled, paper-textured border.
	/contact/, /email-success/ and /email-failure/ are all this shape and each
	used to hold its own ~40-line copy of it. Call it with `webc:nokeep`, so
	the rendered markup is the <section> it always was. Attributes arrive in
	`:`/`@` expressions but NOT in a `webc:setup` block — see nav-links.webc —
	which is why there is no setup block here. -->
<section :id="panelId" class="postcard u-container">
	<h1 class="u-page-title" @text="heading"></h1>
	<div class="postcard-wrapper">
		<div class="postcard-border">
			<slot></slot>
		</div>
	</div>
</section>

<style>
	.postcard {
		font-family: var(--font-base);
		padding-block: var(--space-l);
		text-align: center;
	}

	.postcard-wrapper {
		display: flex;
		justify-content: center;
	}

	.postcard-border {
		border: 4px double var(--taupe);
		padding: var(--space-l);
		max-width: 600px;
		width: 100%;
		background: var(--antiflash-white);
		box-shadow: 5px 5px 20px var(--shadow-medium);
		/* Self-hosted. This was a hotlink to the Transparent Textures CDN — the
		   site's only third-party request, on a site that self-hosts eight font
		   faces and transcodes every image locally, and a render-blocking
		   dependency on a host nobody here controls that would have flattened
		   the panel to a plain cream rectangle the day it went away. Same file,
		   fetched once (Paper Fibers by Heliodor Jalba, 410x410), so the panel
		   looks exactly as it did. */
		background-image: url("/images/paper-fibers.png");
	}

	/* The paragraph the panel exists to show. /contact/ has none — its panel
	   holds a form — and the two outcome pages had this rule twice, under two
	   class names. */
	.postcard-message {
		font-family: var(--font-italic);
		font-style: italic;
		font-size: var(--step-1);
		color: var(--black-olive);
		line-height: 1.6;
		margin-bottom: var(--space-l);
		text-align: center;
	}

	/* The panel's way out, on the two outcome pages. /contact/'s submit
	   control is a real <button> inside the form and keeps its own metrics —
	   it sits in the form's flow, this is an inline-block link in a row. */
	.postcard .button {
		display: inline-block;
		margin-top: var(--space-xs);
		padding: var(--space-xs) var(--space-m);
		font-family: var(--font-base);
		background-color: var(--taupe);
		color: var(--antiflash-white);
		border: none;
		font-size: var(--step-0);
		cursor: pointer;
		letter-spacing: 0.5px;
		transition: background-color 0.3s ease;
		text-decoration: none;
		margin-right: var(--space-xs);

		&:hover {
			background-color: var(--black-olive);
		}
	}
</style>
